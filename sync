#!/usr/bin/env python3
"""Pull the core, link its skills into the knowledge base that holds it, create the slots its README names (ignoring each it marks ignored), purge stale scratch, install the commit gate, and flag each required role the Bindings section omits, each file that keeps Claude Code from reading AGENTS.md, and each suggestions file the knowledge base keeps about the core.

Run as `core/sync`; `--no-pull` skips the fetch. Prints one line per change and one
`attention:` line per thing a person must resolve. The links it removes lead into the
core: one whose target the core has retired, any `.md` link at the knowledge base's
root, and `amend-core` where the knowledge base binds a read-only core. There it also
resets the checkout to its upstream, dropping any edit, file or commit made in it,
denies Claude Code's edits under core/, and flags no suggestions file.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

CORE = os.path.dirname(os.path.realpath(__file__))
KB = os.path.dirname(CORE)
SKILLS = os.path.join(CORE, "skills")
GATE = "core/hooks/commit-gate.py"
# The Bind table's role name, held here; anywhere in the Bindings section it binds, as each Always role's does
READ_ONLY = "read-only core"
WRITER = "amend-core"
# Edit covers every tool that writes a file, and the leading slash anchors at the session's working directory
# A deny rule matches the file a link leads to as well as the link, so this one covers every skill linked into the core
DENY_CORE = "Edit(/core/**)"
# Scratch untouched this long has outlived the work that made it
SCRATCH_DAYS = 14

# The directories every client discovers skills through; either may be a link to one directory the knowledge base keeps
ADAPTERS = (".claude/skills", ".agents/skills")
INSTRUCTIONS = "AGENTS.md"
# Either in a session's start directory or above it turns off Claude Code's reading of AGENTS.md
CLAUDE_FILES = ("CLAUDE.md", "CLAUDE.local.md")
FETCH_SECONDS = 60


def shown(path):
    return os.path.relpath(path, KB)


def attention(line):
    print("attention: " + line)


def configured_ssh():
    found = subprocess.run(["git", "-C", CORE, "config", "core.sshCommand"], capture_output=True, text=True)
    return bool(found.stdout.strip())


def git(*args, timeout=None):
    # A prompt for a credential, a passphrase or a host key would hang an unattended run, so each fails instead
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    # The variable outranks core.sshCommand, so it is set only where the checkout configures no command of its own
    if "GIT_SSH_COMMAND" not in env and not configured_ssh():
        env["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes"
    try:
        return subprocess.run(["git", "-C", CORE, *args], capture_output=True, text=True, env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, "", "fatal: no answer from the remote in %d seconds" % timeout)


def reason(result):
    # git prints its hints before the line that says what failed
    lines = result.stderr.strip().splitlines()
    failures = [line for line in lines if line.startswith(("fatal:", "error:"))]
    return (failures or lines or ["git gave no reason"])[-1]


def pull(read_only):
    """Fetch, then bring the checkout to its upstream; True when the upstream ref is current."""
    fetched = git("fetch", "-q", timeout=FETCH_SECONDS)
    if fetched.returncode != 0:
        attention("core/ was not fetched: " + reason(fetched))
        return False
    # With no upstream there is nothing to compare against, and every missing target would read as retired
    if git("rev-parse", "--verify", "-q", "@{u}").returncode != 0:
        attention("core/ tracks no upstream branch, so it was not pulled")
        return False
    # Read before the move, which empties the range
    titles = git("log", "--format=%s", "HEAD..@{u}").stdout.splitlines()
    # Nothing written in a read-only checkout can reach the core, so no edit there is anyone's work in progress
    if read_only:
        moved = put_back()
    else:
        # Sessions edit core/ in place, so a dirty tree is someone's work in progress
        # A queued suggestion is the exception: git carries it through any fast-forward that leaves its file alone, and refuses one that would not
        dirty = [line[3:] for line in git("status", "--porcelain").stdout.splitlines()]
        if any(not path.startswith("suggestions/") for path in dirty):
            attention("core/ has uncommitted changes, so it was not pulled")
            return True
        # A merge belongs to checkin's pull, which can stop for a person
        moved = git("merge", "--ff-only", "-q", "@{u}")
    if moved.returncode != 0:
        attention("core/ was not pulled: " + reason(moved))
        return True
    # Each title, since a rename or a changed promise reaches another knowledge base only as a commit title
    for title in titles:
        print("pulled: " + title)
    return True


def put_back():
    """Reset a read-only checkout to its upstream and delete what it does not track, naming each edit, file and commit dropped."""
    for line in git("status", "--porcelain", "--untracked-files=no").stdout.splitlines():
        print("put back core/%s, which an edit here changed" % line[3:])
    # An untracked file would ride into a core commit checkin cannot push; ignored files stay
    for line in git("clean", "-nd").stdout.splitlines():
        print("removed core/%s, which the core does not track" % line[len("Would remove "):])
    git("clean", "-fdq")
    for title in git("log", "--format=%s", "@{u}..HEAD").stdout.splitlines():
        print("dropped the core commit %s, which this knowledge base cannot push" % title)
    return git("reset", "--hard", "-q", "@{u}")


def target_of(link):
    return os.path.normpath(os.path.join(os.path.dirname(link), os.readlink(link)))


def tracked(ref, relative):
    return git("cat-file", "-e", "%s:%s" % (ref, relative)).returncode == 0


def retirement(relative, fetched):
    """Why a target missing from the checkout is gone for good, or None where it may not have been pulled yet."""
    # Committed here but gone from the tree: this checkout's own edit retired it, and the link leaves with that edit
    if tracked("HEAD", relative):
        return "an uncommitted edit to core/ retired"
    # Another machine may have added it, which only a fetch made this run can rule out
    if fetched and not tracked("@{u}", relative):
        return "the core has retired"
    return None


def prune(directory, fetched):
    for name in sorted(os.listdir(directory)):
        path = os.path.join(directory, name)
        if not os.path.islink(path) or os.path.exists(path):
            continue
        target = target_of(path)
        if not target.startswith(CORE + os.sep):
            continue
        why = retirement(os.path.relpath(target, CORE), fetched)
        if why:
            os.remove(path)
            print("removed %s, whose target %s" % (shown(path), why))
        else:
            attention("%s does not resolve until core/ is pulled, so it was left" % shown(path))


def link(path, target):
    if os.path.islink(path):
        if os.path.realpath(path) != os.path.realpath(target):
            attention("%s links elsewhere, so the core's %s was not linked" % (shown(path), os.path.basename(target)))
        return
    if os.path.lexists(path):
        attention("%s is the knowledge base's own, so the core's file of that name was not linked" % shown(path))
        return
    # Relative, so the committed link resolves on every machine that clones the core to core/
    os.symlink(os.path.relpath(target, os.path.dirname(path)), path)
    # A target only this checkout holds is someone's unfinished edit, whose link is that session's to commit
    pending = not tracked("HEAD", os.path.relpath(target, CORE))
    print("linked %s%s" % (shown(path), ", whose target core/ has not committed" if pending else ""))


def skill_directories():
    """The real directories behind the adapters, each once, creating both where a knowledge base has neither."""
    paths = [os.path.join(KB, adapter) for adapter in ADAPTERS]
    if not any(os.path.lexists(path) for path in paths):
        for path in paths:
            os.makedirs(path)
            print("created %s" % shown(path))
    found = []
    for path in paths:
        if not os.path.lexists(path):
            continue
        real = os.path.realpath(path)
        if not os.path.isdir(path):
            attention("%s is not a directory, so no skill was linked through it" % shown(path))
        elif not real.startswith(KB + os.sep):
            attention("%s leads outside the knowledge base, so no skill was linked through it" % shown(path))
        elif real not in found:
            found.append(real)
    return found


def unlink_rubric():
    # A root link into the core puts a second path on a rubric the skills cite as core/<name>.md
    for name in sorted(os.listdir(KB)):
        path = os.path.join(KB, name)
        if name.endswith(".md") and os.path.islink(path) and target_of(path).startswith(CORE + os.sep):
            cited = shown(target_of(path))
            os.remove(path)
            attention("removed %s, so cite it as %s wherever the knowledge base's own files name it" % (shown(path), cited))


def link_skills(fetched, read_only):
    skills = sorted(
        name for name in os.listdir(SKILLS) if os.path.isfile(os.path.join(SKILLS, name, "SKILL.md"))
    )
    for directory in skill_directories():
        prune(directory, fetched)
        for name in skills:
            path = os.path.join(directory, name)
            if not (read_only and name == WRITER):
                link(path, os.path.join(SKILLS, name))
            # An amend-core of the knowledge base's own stands; only a link into the core leaves
            elif os.path.islink(path) and target_of(path).startswith(CORE + os.sep):
                os.remove(path)
                print("removed %s, since this knowledge base reads the core only" % shown(path))


def gitignore(name):
    path = os.path.join(KB, ".gitignore")
    text = ""
    if os.path.exists(path):
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    # Any line already naming the root entry counts, a partial ignore under it included, so a knowledge base's own choice stands
    if any(line.strip().lstrip("/").split("/")[0] == name for line in text.splitlines()):
        return
    # No trailing slash, which would match a directory but never a link standing in for one
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(("\n" if text and not text.endswith("\n") else "") + "/%s\n" % name)
    print("added /%s to .gitignore" % name)


def readme_section(heading):
    with open(os.path.join(CORE, "README.md"), encoding="utf-8") as handle:
        text = handle.read()
    marker = "\n## %s\n" % heading
    return text.split(marker, 1)[1].split("\n## ", 1)[0] if marker in text else ""


def table_rows(heading):
    return [
        [cell.strip() for cell in line.strip().strip("|").split("|")]
        for line in readme_section(heading).splitlines()
        if line.strip().startswith("|")
    ]


def always_roles():
    """The roles core/README.md marks Always, by the name before any gloss."""
    return [cells[0].split(" — ")[0] for cells in table_rows("Bind") if len(cells) == 3 and cells[2] == "Always"]


def slots():
    """Each directory core/README.md's Slots table names, with whether git tracks it; a row holding anything but one bare top-level name is skipped."""
    found = []
    for cells in table_rows("Slots"):
        match = re.fullmatch(r"`([A-Za-z0-9][A-Za-z0-9._-]*)/`", cells[0])
        if match:
            # A row with no Git cell is ignored, so only a cell saying tracked keeps a slot in git
            found.append((match.group(1), len(cells) > 2 and cells[2].strip(" .").lower() == "tracked"))
    return found


def kb_tracks(name):
    found = subprocess.run(["git", "-C", KB, "ls-files", "--", name], capture_output=True, text=True)
    return bool(found.stdout.strip())


def kb_ignores(name):
    # A probe path rather than the directory, so a pattern that ignores only its contents counts too
    found = subprocess.run(["git", "-C", KB, "check-ignore", "-q", "--", "%s/probe" % name], capture_output=True, text=True)
    return found.returncode == 0


def make_slots():
    named = slots()
    if not named:
        attention("core/README.md names no slot, so none was created")
    for name, tracked in named:
        path = os.path.join(KB, name)
        # A link to a directory counts as the slot, being how a knowledge base carries one between machines
        if not os.path.isdir(path):
            if os.path.lexists(path):
                attention("%s is not a directory, so the core's slot of that name was not created" % name)
                continue
            os.makedirs(path)
            print("created %s/" % name)
        if tracked:
            if kb_ignores(name):
                attention("%s is the core's tracked slot, but .gitignore hides it from git" % name)
            continue
        # An ignore line would leave tracked files tracked and hide every new one beside them from git
        if kb_tracks(name):
            attention("%s is tracked by git, so it was not ignored as the core's slot" % name)
            continue
        gitignore(name)


def changed(path):
    found = os.lstat(path)
    # A copy or a move can keep a file's old modification time, but either sets its change time to the moment it arrived
    return max(found.st_mtime, found.st_ctime)


def stale_worktrees(path, cutoff):
    """The .git links of the worktrees inside an entry untouched since the cutoff, or None where anything in it changed later."""
    # Writing marks an entry live and reading never does, so a file only read still ages out
    if changed(path) > cutoff:
        return None
    links = []
    if os.path.isdir(path) and not os.path.islink(path):
        for directory, folders, files in os.walk(path):
            for name in folders + files:
                full = os.path.join(directory, name)
                try:
                    if changed(full) > cutoff:
                        return None
                except OSError:
                    continue
                # A worktree's .git is a file naming its admin directory inside the repository it came from
                if name == ".git" and os.path.isfile(full) and not os.path.islink(full):
                    links.append(full)
    return links


def repository_of(link):
    """The git directory a worktree's .git file points into, or None where it names no worktree."""
    try:
        with open(link, encoding="utf-8") as handle:
            line = handle.readline().strip()
    except (OSError, UnicodeDecodeError):
        return None
    if not line.startswith("gitdir:"):
        return None
    # Git may write the path relative to the worktree
    gitdir = os.path.normpath(os.path.join(os.path.dirname(link), line[len("gitdir:"):].strip()))
    marker = os.sep + "worktrees" + os.sep
    return gitdir.rsplit(marker, 1)[0] if marker in gitdir else None


def uncommitted(worktree):
    found = subprocess.run(["git", "-C", worktree, "status", "--porcelain"], capture_output=True, text=True)
    return bool(found.stdout.strip())


def purge_scratch():
    root = os.path.join(KB, "scratch")
    if not os.path.isdir(root):
        return
    cutoff = time.time() - SCRATCH_DAYS * 86400
    for name in sorted(os.listdir(root)):
        path = os.path.join(root, name)
        links = stale_worktrees(path, cutoff)
        if links is None:
            continue
        # Uncommitted work exists nowhere else, so an entry holding any waits for a person
        held = [os.path.dirname(link) for link in links if uncommitted(os.path.dirname(link))]
        if held:
            attention("scratch/%s is unchanged for %d days but %s holds uncommitted work, so it was left" % (name, SCRATCH_DAYS, shown(held[0])))
            continue
        # Read before the removal takes the .git files with it
        repositories = {repository_of(link) for link in links} - {None}
        try:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            else:
                os.remove(path)
        except OSError as error:
            attention("scratch/%s was not removed: %s" % (name, error.strerror or error))
            continue
        print("removed scratch/%s, unchanged for %d days" % (name, SCRATCH_DAYS))
        # A removed worktree stays registered in its repository, which then refuses its branch to any other checkout
        for repository in sorted(repositories):
            subprocess.run(["git", "--git-dir", repository, "worktree", "prune"], capture_output=True, text=True)


SETTINGS = os.path.join(KB, ".claude", "settings.json")


def settings_list(outer, inner):
    """Claude Code's project settings and the list at settings[outer][inner], added in memory where missing, or why the file holds none."""
    settings = {}
    if os.path.exists(SETTINGS):
        try:
            with open(SETTINGS, encoding="utf-8") as handle:
                settings = json.load(handle)
        except ValueError:
            return "is not valid JSON"
    section = settings.setdefault(outer, {}) if isinstance(settings, dict) else None
    found = section.setdefault(inner, []) if isinstance(section, dict) else None
    return (settings, found) if isinstance(found, list) else "holds no %s list" % inner


def save_settings(settings):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")


def install_commit_gate():
    """Have Claude Code run the commit gate before every shell command, unless a hook already names it."""
    found = settings_list("hooks", "PreToolUse")
    if isinstance(found, str):
        attention(".claude/settings.json %s, so the commit gate was not installed" % found)
        return
    settings, entries = found
    # A knowledge base may pass its own recording skills after the path, so any hook naming the gate counts as installed
    if any(GATE in str(hook.get("command", "")) for entry in entries if isinstance(entry, dict) for hook in entry.get("hooks", []) if isinstance(hook, dict)):
        return
    entries.append({"matcher": "Bash", "hooks": [{"type": "command", "command": '"$CLAUDE_PROJECT_DIR"/' + GATE}]})
    save_settings(settings)
    print("installed the commit gate in .claude/settings.json")


def deny_core_edits():
    """Have Claude Code refuse its own edits under core/, unless the rule is already there."""
    # Shell commands and other clients still write here, which the next sync's reset puts back
    found = settings_list("permissions", "deny")
    if isinstance(found, str):
        attention(".claude/settings.json %s, so edits under core/ were not denied" % found)
        return
    settings, rules = found
    if DENY_CORE in rules:
        return
    rules.append(DENY_CORE)
    save_settings(settings)
    print("denied edits under core/ in .claude/settings.json")


def check_suggestions():
    """Name each suggestions file the knowledge base keeps about the core."""
    # No writer of the core reads the knowledge base's suggestions
    folder = os.path.join(KB, "suggestions")
    if not os.path.isdir(folder):
        return
    targets = {name: name for name in os.listdir(SKILLS)}
    targets.update({name[:-3]: name[:-3] for name in os.listdir(CORE) if name.endswith(".md") and name != "README.md"})
    # The knowledge base's own README shares the core's name, so a line about the core's carried a prefix there
    targets["core-README"] = "README"
    for name in sorted(os.listdir(folder)):
        target = targets.get(name[:-3]) if name.endswith(".md") else None
        if target:
            attention("suggestions/%s is about the core's %s, so its lines belong in core/suggestions/%s.md" % (name, target, target))


def bindings_section(path):
    """The text under the file's Bindings heading, or None where it has none."""
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    headings, fenced = [], False
    for index, line in enumerate(lines):
        if line.startswith("```"):
            fenced = not fenced
        elif not fenced and line.startswith("#"):
            headings.append((index, len(line) - len(line.lstrip("#")), line))
    for position, (start, level, line) in enumerate(headings):
        if "Bindings" in line:
            end = next((i for i, depth, _ in headings[position + 1 :] if depth <= level), len(lines))
            return "\n".join(lines[start:end])
    return None


def binds_read_only():
    path = os.path.join(KB, INSTRUCTIONS)
    section = bindings_section(path) if os.path.isfile(path) else None
    return section is not None and READ_ONLY in section.casefold()


def check_bindings():
    """Name each role the knowledge base must bind and does not, since a binding is a judgment only a person makes."""
    roles = always_roles()
    if not roles:
        attention("core/README.md lists no Always role, so no binding was checked")
        return
    path = os.path.join(KB, INSTRUCTIONS)
    if not os.path.isfile(path):
        attention("there is no %s, the file every session reads" % INSTRUCTIONS)
        return
    section = bindings_section(path)
    if section is None:
        attention("%s has no Bindings section" % INSTRUCTIONS)
        return
    for role in roles:
        if role.casefold() not in section.casefold():
            attention("the Bindings section names no %s, which every knowledge base binds" % role.lower())
    with open(path, encoding="utf-8") as handle:
        if not re.search(r"\bcheckin\b", handle.read()):
            attention("%s never names checkin, so a client the commit gate does not reach commits at will" % INSTRUCTIONS)


def check_instructions():
    # A .claude/CLAUDE.md counts at the root alone, since the one above it in the home directory is the user's own and loads beside AGENTS.md
    paths = [os.path.join(KB, ".claude", "CLAUDE.md")]
    # Sessions start at the root or beneath it, so only the root and its ancestors reach every one
    directory = KB
    while True:
        paths += [os.path.join(directory, name) for name in CLAUDE_FILES]
        if os.path.dirname(directory) == directory:
            break
        directory = os.path.dirname(directory)
    for path in paths:
        if os.path.lexists(path):
            attention("%s turns off Claude Code's reading of every %s beneath it" % (shown(path), INSTRUCTIONS))


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--no-pull", action="store_true", help="link from the checkout as it stands")
    args = parser.parse_args()
    # Only a checkout at core/ inside a repository knows which knowledge base it serves, and any other parent would gain links it never asked for
    if os.path.basename(CORE) != "core" or not os.path.exists(os.path.join(KB, ".git")):
        sys.exit("sync: %s is not a core/ checkout inside a knowledge base's repository" % CORE)
    read_only = binds_read_only()
    fetched = False if args.no_pull else pull(read_only)
    unlink_rubric()
    link_skills(fetched, read_only)
    # The checkout is cloned rather than created, so it is no row in the Slots table
    gitignore("core")
    make_slots()
    purge_scratch()
    install_commit_gate()
    # Lifting the binding leaves the deny rule for a person to remove
    if read_only:
        deny_core_edits()
    check_bindings()
    check_instructions()
    # Moving lines into core/suggestions/ is advice a read-only knowledge base cannot take
    if not read_only:
        check_suggestions()


if __name__ == "__main__":
    main()
